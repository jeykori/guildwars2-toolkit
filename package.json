{
	"name": "@jeykori/guildwars2-toolkit",
	"version": "1.7.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jeykori/guildwars2-toolkit.git"
	},
	"homepage": "https://github.com/jeykori/guildwars2-toolkit#readme",
	"license": "MIT",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"scripts": {
		"dev": "cd playground && bun dev",
		"build": "bash scripts/build.sh",
		"prepublishOnly": "bun run build",
		"regen": "bun run --tsconfig-override=playground/tsconfig.app.json scripts/regenerate-data.ts",
		"test": "bun test",
		"check": "bunx biome check --write .",
		"ci": "bunx biome ci .",
		"typecheck:utils": "bunx tsc -p tsconfig.build.utils.json --noEmit",
		"typecheck:ui": "bunx tsc -p tsconfig.build.ui.json --noEmit",
		"typecheck:playground": "bunx tsc -p playground/tsconfig.app.json --noEmit",
		"typecheck:tests": "bunx tsc -p tsconfig.tests.json --noEmit",
		"typecheck": "bun run typecheck:utils && bun run typecheck:ui && bun run typecheck:playground && bun run typecheck:tests",
		"add": "shadcn add"
	},
	"exports": {
		"./utils": {
			"types": "./dist/utils/index.d.ts",
			"import": "./dist/utils/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./ui": {
			"types": "./dist/ui/index.d.ts",
			"import": "./dist/ui/index.js"
		}
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.31.0",
		"tailwind-merge": "^3.6.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/bun": "latest",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"shadcn": "^4.18.0",
		"tsc-alias": "^1.9.1"
	},
	"peerDependencies": {
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"recharts": "3.8.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^5"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		},
		"recharts": {
			"optional": true
		},
		"tailwindcss": {
			"optional": true
		}
	},
	"sideEffects": false
}
